# ────────────────────────────────────────────────
#  TourAlly — Backend Environment Variables
#  Copy this file to .env and fill in your values
# ────────────────────────────────────────────────

# ─── Required ────────────────────────────────────
# Groq LLM (free at https://console.groq.com)
GROQ_API_KEY=gsk_...

# ─── Supabase PostgreSQL (HITL state persistence) ─
# Settings → Database → Connection string → URI mode
# Use the "Direct connection" string (not the pooler)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# ─── LangSmith Observability (highly recommended) ─
# Sign up free at https://smith.langchain.com
# Settings → API Keys → Create new key
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=ls__...
LANGCHAIN_PROJECT=TourAlly
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ─── Aviation MCP — Real flight data (recommended) ─
# Free tier at https://aviationstack.com
AVIATION_STACK_API_KEY=...

# ─── Tavily MCP — Hotel & budget web search (optional) ─
# Free tier at https://tavily.com
TAVILY_API_KEY=tvly-...

# ─── OpenWeather — Custom weather MCP server (optional) ─
# Free tier at https://openweathermap.org/api
OPENWEATHER_API_KEY=...
